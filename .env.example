# Identity branch: explicit migrated DB with a non-superuser, non-BYPASSRLS application role.
# Public deployments require an exact HTTPS origin. Never run this sample against production.
DEPARTMENT_AUTH_ORIGIN=http://127.0.0.1:3181
DEPARTMENT_DATABASE_URL=postgresql://department_ai:replace-me@127.0.0.1:5432/department_ai
DOCLING_BASE_URL=http://127.0.0.1:15001
SILICONFLOW_API_KEY=replace-me
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
METADATA_BASE_URL=https://api.siliconflow.cn/v1
METADATA_API_KEY=replace-me
METADATA_MODEL=deepseek-ai/DeepSeek-V3.2
DEPARTMENT_MCP_URL=http://127.0.0.1:3081/mcp
DEPARTMENT_HARNESS_URL=http://127.0.0.1:3080/
DEPARTMENT_HARNESS_HEALTH_URL=http://127.0.0.1:3080/
# 仅在系统 PATH 中没有 node/pnpm 时需要覆盖。
# DEPARTMENT_NODE_RUNTIME_ROOT=/absolute/path/to/node-runtime
# 可选覆盖；不填写时自动使用 department-ai/runtime-data 下的目录。
# DEPARTMENT_DATA_DIR=/absolute/path/to/department-ai/runtime-data/department-ai-python
# DEPARTMENT_SKILL_DIR=/absolute/path/to/department-ai/runtime-data/department-skills
DEPARTMENT_MAX_SOURCE_BYTES=20971520
DEPARTMENT_PYTHON_HOST=127.0.0.1
DEPARTMENT_PYTHON_PORT=3081

# 独立环境的个人 AI 网关；空映射时隐藏 AI 入口，不回退到共享 Harness。
DEPARTMENT_AI_ORIGINS={}
# 测试例：{"zkxk":"http://127.0.0.1:3182","senyuan":"http://127.0.0.1:3183","shared":"http://127.0.0.1:3184"}
DEPARTMENT_AI_MODELS=["department-test"]
# 仅网关持有模型出口密钥；测试使用独立 model.env，勿整份加载生产 .env。
DEPARTMENT_AI_MODEL_URL=
DEPARTMENT_AI_MODEL_KEY=
# 身份版本只使用 backend/identity_server.py 的显式 --env-file 启动。
# 以下生产候选配置没有默认启用；域名/证书与迁移完成后再配置。
# DEPARTMENT_AI_RUNTIME_MODE=production
# DEPARTMENT_AI_STATE_DIR=/var/lib/dai-ai
# DEPARTMENT_AI_HARNESS_DIR=/root/liao/DepartmentKnowledgeBase/deepseek-harness
# DEPARTMENT_AI_NODE=/usr/local/lib/nodejs/node-v22.22.3-linux-x64/bin/node
# DEPARTMENT_AI_GATEWAY_PORT=3182
# DEPARTMENT_AI_ORIGINS={"zkxk":"https://ai-zkxk.supercomputing7.xyz","senyuan":"https://ai-senyuan.supercomputing7.xyz","shared":"https://ai-shared.supercomputing7.xyz"}

# Personal AI pool (identity gateway). Restart only after active tasks finish.
# Cap counts starting + running + retiring user/space runtimes.
DEPARTMENT_AI_MAX_INSTANCES=2
DEPARTMENT_AI_IDLE_SECONDS=900
DEPARTMENT_AI_MIN_AVAILABLE_MIB=1200

# Personal AI storage admission (per user across spaces; preserves existing files)
DEPARTMENT_AI_USER_STORAGE_MIB=512
DEPARTMENT_AI_USER_FILE_LIMIT=10000
DEPARTMENT_AI_MIN_FREE_MIB=2048
